{
  "pattern": "hexagonal",
  "layers": {
    "domain": {
      "pattern": "src/modules/*/domain/**",
      "allowedImportPrefixes": [],
      "description": "Pure business logic — zero external dependencies"
    },
    "application": {
      "pattern": "src/modules/*/application/**",
      "allowedImportPrefixes": ["@/modules/"],
      "description": "Use cases — depends on domain and port interfaces only"
    },
    "infrastructure": {
      "pattern": "src/modules/*/infrastructure/**",
      "allowedImportPrefixes": ["@/modules/", "@/lib/"],
      "description": "Adapters implementing ports (Prisma, HTTP, etc)"
    },
    "presentation": {
      "pattern": "src/app/**",
      "allowedImportPrefixes": ["@/modules/", "@/components/", "@/lib/"],
      "description": "Next.js App Router — Server Components + Server Actions"
    }
  },
  "testMapping": {
    "src/domain/": "tests/unit/domain/",
    "src/application/": "tests/unit/application/",
    "src/infrastructure/": "tests/integration/"
  },
  "testExtensions": [".test.ts", ".test.js", ".spec.ts", ".spec.js", "_test.go", "_test.py", "Test.java"],
  "implementationExtensions": [".ts", ".js", ".go", ".py", ".java", ".rb"],
  "ignorePaths": ["node_modules/", ".git/", "dist/", "build/", "coverage/", "__pycache__/"]
}
